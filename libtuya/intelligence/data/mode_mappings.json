{
  "hvac_mode_sets": {
    "description": "Real-world HVAC mode string variations extracted from LocalTuya",
    "patterns": {
      "manual_auto_lowercase": {
        "description": "Lowercase manual/auto pattern",
        "mappings": {
          "heat": "manual",
          "auto": "auto"
        }
      },
      "manual_auto_titlecase": {
        "description": "Title case Manual/Auto pattern",
        "mappings": {
          "heat": "Manual",
          "auto": "Auto"
        }
      },
      "manual_auto_uppercase": {
        "description": "Uppercase MANUAL/AUTO pattern", 
        "mappings": {
          "heat": "MANUAL",
          "auto": "AUTO"
        }
      },
      "manual_program": {
        "description": "Manual/Program pattern for thermostats",
        "mappings": {
          "heat": "Manual",
          "auto": "Program"
        }
      },
      "m_p_short": {
        "description": "Short m/p pattern",
        "mappings": {
          "heat": "m",
          "auto": "p"
        }
      },
      "true_false_boolean": {
        "description": "Boolean True/False pattern",
        "mappings": {
          "heat": true
        }
      },
      "five_mode_hvac": {
        "description": "Full 5-mode HVAC system",
        "mappings": {
          "heat": "hot",
          "fan_only": "wind",
          "dry": "wet",
          "cool": "cold",
          "auto": "auto"
        }
      },
      "three_mode_hvac": {
        "description": "Three mode heating/cooling/dehumidify",
        "mappings": {
          "heat": "hot",
          "dry": "dehumidify",
          "cool": "cold"
        }
      },
      "numeric_1_0": {
        "description": "Numeric 1/0 pattern",
        "mappings": {
          "heat": "1",
          "auto": "0"
        }
      }
    }
  },
