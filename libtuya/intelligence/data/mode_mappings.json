  "mode_detection": {
    "description": "Algorithmic mode detection strategies",
    "detection_rules": {
      "hvac_mode_detection": {
        "description": "Detect HVAC mode pattern from DPS values",
        "strategies": [
          {
            "name": "string_analysis",
            "description": "Analyze string patterns to detect case sensitivity",
            "rules": [
              {"pattern": "^[a-z]+$", "type": "lowercase"},
              {"pattern": "^[A-Z][a-z]+$", "type": "titlecase"},
              {"pattern": "^[A-Z]+$", "type": "uppercase"}
            ]
          },
          {
            "name": "boolean_detection", 
            "description": "Detect boolean mode patterns",
            "rules": [
              {"pattern": "^(true|false)$", "type": "boolean"},
              {"pattern": "^(1|0)$", "type": "numeric"}
            ]
          },
          {
            "name": "content_analysis",
            "description": "Analyze mode content to determine type",
            "rules": [
              {"contains": ["manual", "auto"], "type": "manual_auto"},
              {"contains": ["hot", "cold", "wind"], "type": "full_hvac"},
              {"contains": ["program", "holiday"], "type": "preset"}
            ]
          }
        ]
      },
      "light_mode_detection": {
        "description": "Detect light mode pattern from capabilities",
        "strategies": [
          {
            "name": "mode_set_index",
            "description": "Use mode set index to determine pattern",
            "rules": [
              {"index": 0, "type": "colour_music_scene_white"},
              {"index": 1, "type": "manual_music_scene_white"}
            ]
          },
          {
            "name": "capability_analysis", 
            "description": "Analyze device capabilities to infer mode set",
            "rules": [
              {"has_color_temp": true, "default": "colour_music_scene_white"},
              {"rgb_only": true, "default": "manual_music_scene_white"}
            ]
          }
        ]
      }
    }
  },
  "compatibility": {
    "description": "Compatibility notes for mode mapping",
    "localtuya_compatibility": {
      "description": "Maintains full compatibility with LocalTuya mode patterns",
      "extraction_source": "LocalTuya custom_components/localtuya/climate.py and light.py",
      "validation": "All mode sets extracted preserve original string patterns and case sensitivity"
    },
    "homeassistant_compatibility": {
      "description": "Compatible with Home Assistant HVAC mode constants",
      "mode_mapping": "Maps LocalTuya strings to Home Assistant HVACMode enum values"
    }
  }
}