{
  "description": "Scaling and value conversion logic from Home Assistant's Tuya integration",
  "source": "homeassistant/components/tuya/entity.py and const.py",
  "integer_type_data": {
    "description": "IntegerTypeData class handles scaling for integer values",
    "properties": {
      "dpcode": "The DPCode this data applies to",
      "min": "Minimum raw value",
      "max": "Maximum raw value",
      "scale": "Scale factor (power of 10)",
      "step": "Step size",
      "unit": "Unit of measurement (optional)",
      "type": "Type information (optional)"
    },
    "methods": {
      "scale_value": "value / (10 ** scale)",
      "scale_value_back": "int(value * (10 ** scale))",
      "remap_value_to": "Remap value from device range to target range",
      "remap_value_from": "Remap value from target range to device range"
    }
  },
  "enum_type_data": {
    "description": "EnumTypeData class handles enum values",
    "properties": {
      "dpcode": "The DPCode this data applies to",
      "range": "List of valid enum values"
    }
  },
  "remap_value_function": {
    "description": "Core remapping function from util.py",
    "signature": "remap_value(value, from_min=0, from_max=255, to_min=0, to_max=255, reverse=False)",
    "logic": "if reverse: value = from_max - value + from_min; return ((value - from_min) / (from_max - from_min)) * (to_max - to_min) + to_min"
  },
  "color_scaling": {
    "DEFAULT_COLOR_TYPE_DATA": {
      "h_type": {"min": 1, "max": 360, "scale": 0, "step": 1},
      "s_type": {"min": 1, "max": 255, "scale": 0, "step": 1},
      "v_type": {"min": 1, "max": 255, "scale": 0, "step": 1}
    },
    "DEFAULT_COLOR_TYPE_DATA_V2": {
      "h_type": {"min": 1, "max": 360, "scale": 0, "step": 1},
      "s_type": {"min": 1, "max": 1000, "scale": 0, "step": 1},
      "v_type": {"min": 1, "max": 1000, "scale": 0, "step": 1}
    },
    "hs_color_conversion": "h: remap_value_to(h_value, 0, 360), s: remap_value_to(s_value, 0, 100)",
    "brightness_conversion": "round(remap_value_to(v_value, 0, 255))"
  },
  "brightness_scaling": {
    "common_ranges": {
      "10_to_1000": "Scale 0, min 10, max 1000",
      "25_to_255": "Scale 0, min 25, max 255", 
