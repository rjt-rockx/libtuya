  "electricity_type_data": {
    "description": "ElectricityTypeData for raw electrical measurements",
    "raw_decoding": {
      "voltage": "struct.unpack('>H', raw[0:2])[0] / 10.0",
      "current": "struct.unpack('>L', b'\\x00' + raw[2:5])[0] / 1000.0",
      "power": "struct.unpack('>L', b'\\x00' + raw[5:8])[0] / 1000.0"
    }
  },
  "dptype_mapping": {
    "description": "Maps cloud DPTypes to standard DPType enum",
    "mappings": {
