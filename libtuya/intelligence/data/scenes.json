  "scene_detection": {
    "description": "Algorithmic scene detection based on device capabilities",
    "detection_rules": {
      "rgbw_1000": {
        "conditions": [
          {"dps_type": "scene", "dps_id": ">=20"},
          {"has_brightness": true, "brightness_max": 1000}
        ],
        "library": "RGBW_1000"
      },
      "rgbw_255": {
        "conditions": [
          {"dps_type": "scene", "dps_id": "<20"},
          {"has_brightness": true, "brightness_max": 255}
        ],
        "library": "RGBW_255"
      },
      "rgb_1000": {
        "conditions": [
          {"no_brightness_dps": true},
          {"has_color": true, "brightness_max": 1000}
        ],
        "library": "RGB_1000"
      }
    }
  },
  "light_modes": {
    "description": "Light mode patterns extracted from LocalTuya",
    "mode_sets": {
      "colour_music_scene_white": {
        "color": "colour",
        "music": "music", 
        "scene": "scene",
        "white": "white"
      },
      "manual_music_scene_white": {
        "color": "manual",
        "music": "music",
        "scene": "scene", 
        "white": "white"
      }
    },
    "mode_detection": {
      "0": "colour_music_scene_white",
      "1": "manual_music_scene_white"
    }
  },
